{
  "name": "faro",
  "version": "0.1.0",
  "private": true,
  "description": "Earthquake information and local travel preparedness, in Spanish and English.",
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:public",
    "check:public": "node scripts/check-public.mjs",
    "export:source": "node scripts/export-source.mjs",
    "prepare:release": "npm run check && npm run build && npm run export:source",
    "notices": "node scripts/dependency-notices.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@tailwindcss/vite": "4.3.3",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "lucide-react": "1.58.0",
    "maplibre-gl": "6.14.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tar": "7.5.22",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/garagon/faro.git"
  },
  "bugs": {
    "url": "https://github.com/garagon/faro/issues"
  },
  "homepage": "https://github.com/garagon/faro#readme"
}
